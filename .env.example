# Copy to ~/.config/espo-voice-agent/.env (chmod 600). Never commit real values.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Optional: fallback LLM if Vertex AI is unavailable (Gemini 3.6 Flash via OpenRouter)
OPENROUTER_API_KEY=
# Optional: only for TTS_PROVIDER=elevenlabs
ELEVEN_API_KEY=

# Gemini runs on Vertex AI with Application Default Credentials (on GCE: the VM's service account).
GCP_PROJECT=<your-gcp-project>
GCP_LOCATION=global

# Optional overrides (defaults shown)
# LLM_MODEL=gemini-3.1-flash-lite          # voice agent
# BROWSER_LLM_MODEL=gemini-3.1-flash-lite  # browser agent
# STT_MODE=flux                            # or nova (Nova-3 + LiveKit turn detector)
# TTS_PROVIDER=fish                        # fish (via LiveKit Inference) | elevenlabs | deepgram
# MAX_CALL_SECONDS=240
# MAX_CONCURRENT_CALLS=3
